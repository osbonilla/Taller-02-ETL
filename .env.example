# .env.example
# =============================================================================
# PLANTILLA de variables de entorno para Taller-02-ETL.
#
# Este archivo SI se versiona en git (a diferencia de .env, que esta en
# .gitignore). Sirve para que cualquiera que clone el repositorio sepa
# exactamente que variables necesita definir, sin exponer las credenciales
# reales usadas en desarrollo.
#
# Uso:
#   cp .env.example .env
#   (edita .env con tus propios valores si lo deseas; los de ejemplo ya
#    funcionan tal cual para levantar el proyecto localmente)
#
# Nota: en este proyecto academico, el .env real YA se entrega junto al
# repositorio con valores funcionales (ver README, seccion Seguridad, para
# la justificacion de esa decision). Este .env.example documenta la
# plantilla "canonica" por buenas practicas, con valores de ejemplo que
# NO deberian reutilizarse en un entorno real/productivo.
# =============================================================================

# --- Version del Elastic Stack (Elasticsearch + Logstash + Kibana) ---------
# Deben ser SIEMPRE la misma version entre los tres componentes.
ELK_VERSION=9.4.5

# --- Puertos expuestos al host ---------------------------------------------
# Cambia estos valores si ya tienes algo corriendo localmente en esos puertos.
ES_PORT=9200
KIBANA_PORT=5601
LOGSTASH_HTTP_PORT=8080
LOGSTASH_MONITOR_PORT=9600
MYSQL_EXTERNAL_PORT=3306
POSTGRES_EXTERNAL_PORT=5432
MONGO_EXTERNAL_PORT=27017

# --- Elasticsearch ------------------------------------------------------
ES_HEAP_SIZE=512m
ES_INDEX_PREFIX=taller

# --- MySQL (fuente relacional #1: tabla usuarios) ---------------------------
MYSQL_ROOT_PASSWORD=changeme_root_password
MYSQL_DATABASE=taller_mysql
MYSQL_USER=taller_user
MYSQL_PASSWORD=changeme_mysql_password

# --- PostgreSQL (fuente relacional #2: tabla clientes) ----------------------
POSTGRES_DB=taller_postgres
POSTGRES_USER=taller_user
POSTGRES_PASSWORD=changeme_postgres_password

# --- MongoDB (fuente NoSQL: coleccion inventario) ---------------------------
MONGO_INITDB_ROOT_USERNAME=taller_admin
MONGO_INITDB_ROOT_PASSWORD=changeme_mongo_password
MONGO_INITDB_DATABASE=taller_mongo

# --- Pipeline batch (python-batch) ------------------------------------------
# Cada cuantos segundos se repite el ciclo ETL completo (CSV+MySQL+Postgres+Mongo).
BATCH_INTERVAL_SECONDS=120
# Si es "true", el batch corre UNA sola vez y el contenedor termina (util para
# pruebas manuales o para integrarlo con Airflow, ver airflow/dags/).
BATCH_RUN_ONCE=false

# --- Pipeline near real-time (python-producer) ------------------------------
# Cada cuantos segundos se genera y envia una transaccion sintetica.
PRODUCER_INTERVAL_SECONDS=5

# --- Logging -----------------------------------------------------------
LOG_LEVEL=INFO
